# PostgreSQL Database Connection URL (e.g. Aiven, Supabase, Neon, or local Postgres)
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Google OAuth Client ID for consumer login
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Server Port (optional, defaults to 5000 in server.ts)
PORT=5000

# Optional: restrict CORS to your frontend origin(s), comma-separated.
# Leave unset for open CORS during local development.
# FRONTEND_ORIGIN=http://localhost:5173,https://your-production-domain.com
