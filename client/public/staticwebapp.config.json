{
  "globalHeaders": {
    "Cross-Origin-Opener-Policy": "same-origin-allow-popups"
  },
  "routes": [
    {
      "route": "/PeediaCart_Official_Brochure.pdf",
      "redirect": "/Markit_Merchant_Brochure_Trifold_A4.pdf",
      "statusCode": 301
    },
    {
      "route": "/PeediaCart_Merchant_Brochure.pdf",
      "redirect": "/Markit_Merchant_Brochure_Trifold_A4.pdf",
      "statusCode": 301
    },
    {
      "route": "/PeediaCart_Consumer_Brochure.pdf",
      "redirect": "/Markit_Consumer_Brochure_Trifold_A4.pdf",
      "statusCode": 301
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/*.{css,js,json,ico,png,jpg,jpeg,gif,svg,webp,woff,woff2,ttf,pdf}",
      "/api/*"
    ]
  },
  "mimeTypes": {
    ".pdf": "application/pdf"
  }
}